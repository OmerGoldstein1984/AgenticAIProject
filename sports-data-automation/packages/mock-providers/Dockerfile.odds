# Dockerfile for Mock Odds Feed
# =============================
# Builds the mock WebSocket odds provider (python -m mock.odds_feed) on port 8080.
# Non-root user, exposes 8080, installs deps from pyproject.toml.
# # GAP: no .dockerignore, so dev files could be copied into the image. See 07_issues_found.md.
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[dev]"

# Copy source code
COPY src/ ./src/

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8080

# Run
CMD ["python", "-m", "mock.odds_feed"]